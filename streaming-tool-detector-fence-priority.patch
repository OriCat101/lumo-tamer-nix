-    // Look for code fence start
+    // Look for code fence start and raw JSON start; whichever occurs earlier
+    // in pendingText wins. A stray, unmatched closing ``` that trails a raw
+    // (unfenced) JSON tool call must not be treated as an opening fence and
+    // hijack JSON that started earlier in the buffer - see regression test
+    // for the exact failure mode this guards against.
     const fenceMatch = this.pendingText.match(/```(?:json)?\s*\n?/);
-    if (fenceMatch && fenceMatch.index !== undefined) {
+    const jsonMatch = this.pendingText.match(/(?:^|\n)\s*(\{[\n\s]*")/);
+
+    if (
+      fenceMatch &&
+      fenceMatch.index !== undefined &&
+      (!jsonMatch || jsonMatch.index === undefined || fenceMatch.index <= jsonMatch.index)
+    ) {

       logger.debug(`Code block opener found: ${this.showSnippet(fenceMatch.index)}`);

